{
  "name": "infinity-squared-website",
  "version": "0.1.0",
  "scripts": {
    "build:app": "npx babel app.js --out-file lib/app.min.js --minified",
    "build:components": "npx babel components/ --out-dir lib/components --minified",
    "build:pages": "npx babel pages/ --out-dir lib/pages --minified",
    "build:utils": "npx babel utils/ --out-dir lib/utils --minified",
    "build:tailwind": "npx tailwindcss -o lib/styles/tail.min.css --minify",
    "build:styles": "npx postcss main.css -o lib/styles/main.min.css --use cssnano --no-map",
    "build": "npm-run-all --parallel build:*",
    "clean": "rm -rf lib",
    "watch:app": "npx babel app.js --out-file lib/app.min.js --minified --watch",
    "watch:components": "npx babel components/ --out-dir lib/components --minified --watch",
    "watch:pages": "npx babel pages/ --out-dir lib/pages --minified --watch",
    "watch:utils": "npx babel utils/ --out-dir lib/utils --minified --watch",
    "watch:tailwind": "npx tailwindcss -o lib/styles/tail.min.css --minify --watch",
    "watch:styles": "npx postcss main.css -o lib/styles/main.min.css --use cssnano --no-map --watch",
    "watch": "npm-run-all --parallel watch:*"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/plugin-syntax-jsx": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@tailwindcss/cli": "^4.1.12",
    "cssnano": "^7.1.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "postcss-cli": "^10.1.0"
  }
}
